---
import FragmentWall from './FragmentWall.tsx';
---

<FragmentWall client:idle />

<style>
  .fragments {
    display: grid;
    margin-top: 0;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--bg);
    margin: 2rem 0;
  }
  .fragments :global(.fragment) {
    background: var(--surface);
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .fragments :global(.fragment-wide) {
    grid-column: span 2;
  }
  .fragments :global(.fragment-label) {
    font-size: var(--step-small);
    color: var(--muted);
    margin: 0;
  }
  .fragments :global(.fragment-body) {
    display: flex;
    align-items: center;
    min-height: 3rem;
  }
  .fragments :global(.fragment-body > *) {
    width: 100%;
  }
  @media (max-width: 47.99em) {
    .fragments :global(.fragment-wide) {
      grid-column: span 1;
    }
  }
</style>